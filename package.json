{
  "name": "agenda-bodas-morelia",
  "version": "1.0.0",
  "private": true,
  "description": "Agenda interna de turnos para una organizadora de bodas de Morelia. React + Tailwind + localStorage, sin servidor de datos.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p ${PORT:-3100}",
    "build": "next build",
    "start": "npx serve out -l ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "prettier": {
    "printWidth": 110,
    "singleQuote": true,
    "trailingComma": "all"
  }
}
